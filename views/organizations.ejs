<%- include('partials/header') %>
<main id="main-content" class="container page-content">
	<div class="page-intro">
		<p class="eyebrow">Partners in impact</p>
		<h1><%= title %></h1>
		<p class="lead">Meet a few groups creating opportunities to serve and strengthen our community.</p>
	</div>
	<div class="card-grid">
		<% organizations.forEach(organization => { %>
			<article class="info-card">
				<img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo">
				<h2><a href="/organization/<%= organization.organization_id %>"><%= organization.name %></a></h2>
				<p><%= organization.description %></p>
				<p><%= organization.contact_email %></p>
			</article>
		<% }) %>
	</div>
</main>
<%- include('partials/footer') %>
