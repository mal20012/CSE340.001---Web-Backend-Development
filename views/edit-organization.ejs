<%- include('partials/header') %>
<main id="main-content" class="container page-content">
	<div class="page-intro">
		<p class="eyebrow">Partner organization</p>
		<h1><%= title %></h1>
	</div>
	<form class="info-card form-layout" action="/edit-organization/<%= organization.organization_id %>" method="POST">
		<div class="form-group">
			<label for="name">Organization name</label>
			<input id="name" name="name" type="text" minlength="3" maxlength="150" value="<%= organization.name %>" required>
		</div>
		<div class="form-group">
			<label for="description">Description</label>
			<textarea id="description" name="description" rows="5" maxlength="500" required><%= organization.description %></textarea>
		</div>
		<div class="form-group">
			<label for="contact_email">Contact email</label>
			<input id="contact_email" name="contact_email" type="email" maxlength="255" value="<%= organization.contact_email %>" required>
		</div>
		<div class="form-group">
			<label for="logo_filename">Logo filename</label>
			<input id="logo_filename" name="logo_filename" type="text" maxlength="255" value="<%= organization.logo_filename %>" required>
		</div>
		<button class="button" type="submit">Update Organization</button>
	</form>
</main>
<%- include('partials/footer') %>