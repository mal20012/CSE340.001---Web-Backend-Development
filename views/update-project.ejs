<%- include('partials/header') %>
<main id="main-content" class="container page-content">
	<div class="page-intro">
		<p class="eyebrow">Edit service project</p>
		<h1><%= title %></h1>
	</div>

	<form class="info-card form-layout" action="/edit-project/<%= project.project_id %>" method="POST">
		<div class="form-group">
			<label for="title">Project title</label>
			<input id="title" name="title" type="text" minlength="3" maxlength="150" value="<%= project.title %>" required>
		</div>
		<div class="form-group">
			<label for="description">Description</label>
			<textarea id="description" name="description" rows="5" maxlength="999" required><%= project.description %></textarea>
		</div>
		<div class="form-group">
			<label for="location">Location</label>
			<input id="location" name="location" type="text" maxlength="199" value="<%= project.location %>" required>
		</div>
		<div class="form-group">
			<label for="date">Date</label>
			<input id="date" name="date" type="date" value="<%= project.date.toISOString().slice(0, 10) %>" required>
		</div>
		<div class="form-group">
			<label for="organizationId">Organization</label>
			<select id="organizationId" name="organizationId" required>
				<% organizations.forEach(organization => { %>
					<option value="<%= organization.organization_id %>" <%= organization.organization_id === project.organization_id ? 'selected' : '' %>><%= organization.name %></option>
				<% }) %>
			</select>
		</div>
		<button class="button" type="submit">Update Project</button>
	</form>
</main>
<%- include('partials/footer') %>