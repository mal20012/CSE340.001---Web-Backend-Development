<%- include('partials/header') %>
<main id="main-content" class="container page-content">
	<div class="page-intro">
		<p class="eyebrow">Category</p>
		<h1><%= title %></h1>
	</div>
	<form class="info-card form-layout" action="/edit-category/<%= category.category_id %>" method="POST">
		<div class="form-group">
			<label for="name">Category name</label>
			<input id="name" name="name" type="text" maxlength="100" value="<%= category.name %>" required>
		</div>
		<button class="button" type="submit">Update Category</button>
	</form>
</main>
<%- include('partials/footer') %>