<%- include('partials/header') %>
<main id="main-content" class="container page-content">
	<div class="page-intro">
		<p class="eyebrow">Ways to help</p>
		<h1><%= title %></h1>
		<p class="lead">Start with a cause that feels meaningful to you.</p>
	</div>
	<div class="project-list">
		<% projects.forEach(project => { %>
			<article class="info-card">
				<h2><a href="/project/<%= project.project_id %>"><%= project.title %></a></h2>
				<p><%= project.description %></p>
				<p><strong>Organization:</strong> <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></p>
				<p><strong>Location:</strong> <%= project.location %></p>
				<p><strong>Date:</strong> <%= project.date.toISOString().slice(0, 10) %></p>
			</article>
		<% }) %>
	</div>
</main>
<%- include('partials/footer') %>
