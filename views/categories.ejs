<%- include('partials/header') %>
<main id="main-content" class="container page-content">
	<div class="page-intro">
		<p class="eyebrow">Choose your impact</p>
		<h1><%= title %></h1>
		<p class="lead">Explore the areas where your interests and time can make the greatest difference.</p>
	</div>
	<div class="card-grid two-columns">
		<% categories.forEach(category => { %>
			<article class="info-card">
				<h2><a href="/category/<%= category.category_id %>"><%= category.name %></a></h2>
			</article>
		<% }) %>
	</div>
</main>
<%- include('partials/footer') %>
