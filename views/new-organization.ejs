<%- include('partials/header') %>
<main id="main-content" class="container page-content">
	<div class="page-intro">
		<p class="eyebrow">Add an organization</p>
		<h1><%= title %></h1>
	</div>

	<form class="info-card" method="POST" action="/organizations">
		<div class="form-group">
			<label for="name">Organization name</label>
			<input id="name" name="name" type="text" minlength="3" maxlength="150" required>
		</div>
		<div class="form-group">
			<label for="description">Description</label>
			<textarea id="description" name="description" rows="5" maxlength="500" required></textarea>
		</div>
		<div class="form-group">
			<label for="contact_email">Contact email</label>
			<input id="contact_email" name="contact_email" type="email" maxlength="255" required>
		</div>
		<button class="button" type="submit">Create organization</button>
	</form>
</main>
<%- include('partials/footer') %>
