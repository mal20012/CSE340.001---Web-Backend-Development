<%- include('partials/header') %>
<main id="main-content" class="container page-content">
	<div class="page-intro">
		<p class="eyebrow">Add a service project</p>
		<h1><%= title %></h1>
	</div>

	<form class="info-card form-layout" action="/new-project" method="POST">
		<div class="form-group">
			<label for="title">Project title</label>
			<input id="title" name="title" type="text" minlength="3" maxlength="150" required>
		</div>
		<div class="form-group">
			<label for="description">Description</label>
			<textarea id="description" name="description" rows="5" maxlength="999" required></textarea>
		</div>
		<div class="form-group">
			<label for="location">Location</label>
			<input id="location" name="location" type="text" maxlength="199" required>
		</div>
		<div class="form-group">
			<label for="date">Date</label>
			<input id="date" name="date" type="date" required>
		</div>
		<div class="form-group">
			<label for="organizationId">Organization</label>
			<select id="organizationId" name="organizationId" required>
				<option value="">Select an organization</option>
				<% organizations.forEach(organization => { %>
					<option value="<%= organization.organization_id %>"><%= organization.name %></option>
				<% }) %>
			</select>
		</div>
		<button class="button" type="submit">Create project</button>
	</form>
</main>
<%- include('partials/footer') %>