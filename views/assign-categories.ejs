<%- include('partials/header') %>
<main id="main-content" class="container page-content">
	<div class="page-intro">
		<p class="eyebrow">Project categories</p>
		<h1><%= projectDetails.title %></h1>
		<p class="lead"><%= title %></p>
	</div>

	<form class="info-card form-layout" action="/assign-categories/<%= projectId %>" method="POST">
		<fieldset class="category-options">
			<legend>Choose categories</legend>
			<% categories.forEach(category => { %>
				<div class="form-group checkbox-group">
					<input
						id="category-<%= category.category_id %>"
						name="categoryIds"
						type="checkbox"
						value="<%= category.category_id %>"
						<%= assignedCategories.some(assigned => assigned.category_id === category.category_id) ? 'checked' : '' %>
					>
					<label for="category-<%= category.category_id %>"><%= category.name %></label>
				</div>
			<% }) %>
		</fieldset>
		<button class="button" type="submit">Update Categories</button>
	</form>
</main>
<%- include('partials/footer') %>